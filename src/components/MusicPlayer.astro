---
// 背景音乐播放器组件（多曲目）
// 右下角悬浮按钮：播放/暂停 + 上一首/下一首 + 音量调节，设置记忆在 localStorage
//
// 使用方法：
// 1. 把音乐文件放到 public/music/ 目录下（文件名随意，mp3/ogg/m4a 均可）
// 2. 在下面 tracks 数组里按顺序添加 { file: '你的文件名.mp3', name: '显示名' }
// 3. 想要更多歌就多写几行，没有就留一首
const tracks = [
  { file: '一场恋爱-杨宗纬-30349360.mp3', name: '一场恋爱 · 杨宗纬' },
  { file: '广岛之恋.mp3', name: '广岛之恋' },
  { file: '文杰-寂寞旅行.mp3', name: '寂寞旅行 · 文杰' },
];
---
<audio id="bg-audio" preload="none" transition:persist></audio>

<button id="music-fab" class="music-fab" transition:persist aria-label="背景音乐设置">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
    <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z" />
  </svg>
</button>

<div id="music-panel" class="music-panel" transition:persist hidden>
  <div id="music-title" class="music-title">未选择曲目</div>
  <div class="music-controls">
    <button id="music-prev" class="music-btn" aria-label="上一首">⏮</button>
    <button id="music-play" class="music-btn play" aria-label="播放/暂停">▶</button>
    <button id="music-next" class="music-btn" aria-label="下一首">⏭</button>
  </div>
  <input id="music-volume" class="music-volume" type="range" min="0" max="100" value="40" aria-label="音量" />
  <div id="music-state" class="music-state">点击播放开启背景音乐</div>
</div>

<style>
  .music-fab {
    position: fixed;
    right: 22px;
    top: 72px;
    z-index: 100;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(13, 20, 38, 0.85);
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 20px rgba(34, 211, 238, 0.12);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .music-fab:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5), 0 0 28px rgba(34, 211, 238, 0.3);
  }

  .music-fab.playing svg {
    animation: spin 3s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .music-panel {
    position: fixed;
    right: 22px;
    top: 130px;
    z-index: 100;
    width: 230px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(13, 20, 38, 0.92);
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .music-panel[hidden] {
    display: none;
  }

  .music-title {
    font-size: 12px;
    color: var(--cyan);
    text-align: center;
    font-family: var(--mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-controls {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .music-btn {
    width: 38px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: rgba(34, 211, 238, 0.1);
    color: var(--cyan);
    font-size: 14px;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .music-btn:hover {
    background: rgba(34, 211, 238, 0.2);
  }

  .music-btn.play {
    background: rgba(34, 211, 238, 0.2);
  }

  .music-volume {
    width: 100%;
    accent-color: var(--cyan);
  }

  .music-state {
    font-size: 11px;
    color: var(--text-dim);
    text-align: center;
  }
</style>

<script is:inline define:vars={{ tracks: tracks.map((t) => ({ src: '/music/' + encodeURIComponent(t.file), name: t.name })) }}>
  (() => {
    const audio = document.getElementById('bg-audio');
    const fab = document.getElementById('music-fab');
    const panel = document.getElementById('music-panel');
    const playBtn = document.getElementById('music-play');
    const prevBtn = document.getElementById('music-prev');
    const nextBtn = document.getElementById('music-next');
    const volInput = document.getElementById('music-volume');
    const stateEl = document.getElementById('music-state');
    const titleEl = document.getElementById('music-title');

    if (!audio || tracks.length === 0) return;

    // 读取记忆的设置
    const saved = (() => {
      try { return JSON.parse(localStorage.getItem('bg-music') || '{}'); } catch { return {}; }
    })();
    const volume = Math.min(100, Math.max(0, saved.volume ?? 40));
    audio.volume = volume / 100;
    volInput.value = volume;

    let index = Math.min(tracks.length - 1, Math.max(0, saved.index ?? 0));

    function setTitle() {
      titleEl.textContent = tracks[index]?.name || '';
    }

    function save() {
      localStorage.setItem('bg-music', JSON.stringify({ volume: audio.volume * 100, index }));
    }

    function setState() {
      const playing = !audio.paused && !audio.ended && audio.src !== '';
      fab.classList.toggle('playing', playing);
      playBtn.textContent = playing ? '⏸' : '▶';
      stateEl.textContent = playing
        ? '正在播放'
        : (audio.currentTime > 0 ? '已暂停' : '点击播放开启背景音乐');
    }

    function loadTrack(i, autoplay) {
      index = (i + tracks.length) % tracks.length;
      audio.src = tracks[index].src;
      setTitle();
      save();
      if (autoplay) audio.play().catch(() => setState());
    }

    // 尝试自动播放；被浏览器拦截时静默处理，用户可手动点播放按钮
    async function tryAutoPlay() {
      // 已记忆过音量但未记忆过曲目播放中状态，每次都尝试
      if (audio.paused && audio.src === '') {
        index = Math.min(tracks.length - 1, Math.max(0, saved.index ?? 0));
        audio.src = tracks[index].src;
        setTitle();
      }
      try {
        await audio.play();
        setState();
      } catch (err) {
        // 浏览器禁止无手势自动播放：静默，不提示
      }
    }

    // 客户端路由切换页面后不重复自动播放（已播放则跳过）
    function onPageLoad() {
      if (audio.paused && !audio.ended) {
        tryAutoPlay();
      }
    }

    // 首次播放需要用户点击（浏览器禁止自动播放）
    playBtn.addEventListener('click', async () => {
      if (audio.src === '') {
        loadTrack(index, true);
        return;
      }
      if (audio.paused) {
        audio.play().catch(() => (stateEl.textContent = '播放失败，请检查音乐文件'));
      } else {
        audio.pause();
      }
      save();
      setState();
    });

    prevBtn.addEventListener('click', () => loadTrack(index - 1, !audio.paused));
    nextBtn.addEventListener('click', () => loadTrack(index + 1, !audio.paused));

    fab.addEventListener('click', () => {
      panel.hidden = !panel.hidden;
    });

    volInput.addEventListener('input', () => {
      audio.volume = volInput.value / 100;
      save();
    });

    // 一首播完自动切下一首
    audio.addEventListener('ended', () => loadTrack(index + 1, true));
    audio.addEventListener('play', setState);
    audio.addEventListener('pause', setState);
    setTitle();
    setState();

    // 打开网页自动播放（浏览器放行则直接播放）
    const initAutoPlay = () => {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', onPageLoad);
      } else {
        onPageLoad();
      }
    };
    initAutoPlay();
    document.addEventListener('astro:page-load', onPageLoad);
  })();
</script>
