---
// 基础布局：导航 + 页脚 + 全局暗色科技风样式
import '../styles/global.css';
import MusicPlayer from '../components/MusicPlayer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI 时代数据库运维 · 大厂老兵的技术博客' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 页面切换走客户端路由，避免整页刷新导致音乐中断 -->
    <ClientRouter />
    <!-- 不蒜子访问统计（纯静态站无需后端） -->
    <script is:inline src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
  </head>
  <body>
    <!-- 访问统计：固定在屏幕最左上角，滚动不跟随，切页保持不重复计数 -->
    <div class="visit-stats" transition:persist>
      <span>今日访问: <b id="busuanzi_today_pv">--</b></span>
      <span class="sep">·</span>
      <span>总访问次数: <b id="busuanzi_site_pv">--</b></span>
    </div>

    <nav class="site-nav">
      <div class="site-nav-inner">
        <div class="brand-left">
          <a class="brand" href="/"><span class="accent">DB</span>&gt;AI</a>
        </div>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="/data-ops">数据运维</a>
          <a href="/software">软件开发</a>
          <a href="/blog">文章</a>
          <a href="/about">关于</a>
        </div>
      </div>
    </nav>

    <slot />

    <MusicPlayer />

    <footer class="site-footer">
      <div>
        用 <span class="mono">Astro</span> 构建 · 17 年数据库老兵 · AI 时代运维实践
      </div>
      <div class="site-icp">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">苏ICP备2026054852号-1</a>
      </div>
    </footer>
  </body>
</html>
